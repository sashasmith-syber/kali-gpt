# KaliGPT Backend Configuration
# Copy this file to .env and update with your values

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false

# Security — required; generate a unique value for each deployment and keep it stable
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Admin seed (created only if no admin exists)
# Use 16+ characters with uppercase, lowercase, and a digit; maximum 72 UTF-8 bytes.
# Never commit the real value.
KALIGPT_ADMIN_PASSWORD=
KALIGPT_ADMIN_USERNAME=admin
KALIGPT_ADMIN_EMAIL=admin@example.com
# Local-first: leave false. Seed admin from KALIGPT_ADMIN_PASSWORD only.
KALIGPT_ALLOW_REGISTRATION=false

# CORS Settings (5173 matches Vite in backend/frontend/vite.config.ts)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Command Execution
MAX_COMMAND_TIMEOUT=300
ENABLE_COMMAND_LOGGING=true
ENABLE_DOCKER_SOCK=false

# Logging
LOG_LEVEL=INFO
LOG_FILE=/var/log/kaligpt/app.log

# Rate Limiting (memory for local-first; Redis later for team)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_STORAGE=memory://
# REDIS_URL=redis://localhost:6379/0

# Local LLM
LLM_PROVIDER=none
# Use http://ollama:11434 for Docker Compose; use localhost for a local backend.
OLLAMA_HOST=http://ollama:11434
LM_STUDIO_HOST=http://localhost:1234
LLM_MODEL=llama3:latest
LLM_TIMEOUT=120
LLM_CONNECT_TIMEOUT=5

# Persistence — Compose defaults to sqlite:////data/kaligpt.db on kaligpt-data.
# DATABASE_URL=sqlite:///./data/kaligpt.db
# Team profile (Postgres; URL-encode special characters in the password):
# DATABASE_URL=postgresql+psycopg://kaligpt:CHANGE_ME@postgres:5432/kaligpt
# DB_PASSWORD=

# Cloud LLM placeholders (deferred)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
