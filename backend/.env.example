# KaliGPT Backend Configuration
# Copy this file to .env and update with your values

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false

# Security — generate once and keep stable across restarts
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-here-change-this-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Admin seed (created only if no admin exists)
# Set locally to a unique password of at least 16 characters; never commit the real value.
KALIGPT_ADMIN_PASSWORD=
KALIGPT_ADMIN_USERNAME=admin
KALIGPT_ADMIN_EMAIL=admin@example.com

# CORS Settings (5173 matches Vite in backend/frontend/vite.config.ts)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Command Execution
MAX_COMMAND_TIMEOUT=300
ENABLE_COMMAND_LOGGING=true
ENABLE_DOCKER_SOCK=false

# Logging
LOG_LEVEL=INFO
LOG_FILE=/var/log/kaligpt/app.log

# Rate Limiting (memory for local-first; Redis later for team)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_STORAGE=memory://
# REDIS_URL=redis://localhost:6379/0

# Local LLM
LLM_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
LM_STUDIO_HOST=http://localhost:1234
LLM_MODEL=llama3:latest
LLM_TIMEOUT=120
LLM_CONNECT_TIMEOUT=5

# Persistence — SQLite local-first (default)
DATABASE_URL=sqlite:///./data/kaligpt.db
# Docker volume path:
# DATABASE_URL=sqlite:////data/kaligpt.db
# Team profile (Postgres):
# DATABASE_URL=postgresql+psycopg://kaligpt:CHANGE_ME@postgres:5432/kaligpt
# DB_PASSWORD=

# Cloud LLM placeholders (deferred)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
