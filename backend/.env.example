# KaliGPT Backend Configuration
# Copy this file to .env and update with your values

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false

# Security Settings
SECRET_KEY=your-secret-key-here-change-this-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Settings (5173 matches Vite in backend/frontend/vite.config.ts)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Command Execution
MAX_COMMAND_TIMEOUT=300
ENABLE_COMMAND_LOGGING=true

# Logging
LOG_LEVEL=INFO
LOG_FILE=/var/log/kaligpt/app.log

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_STORAGE=memory://

# LLM Integration (Optional)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Database (Future)
# DATABASE_URL=postgresql://user:password@localhost/kaligpt

# Redis (Future - for rate limiting)
# REDIS_URL=redis://localhost:6379/0
